      "type": "table",
      "headers": [
        "Αντωνυμία",
        "Έκφραση",
        "Παράδειγμα"
      ],
      "rows": [
        [
          "Σε μένα",
          "μου αρέσει",
          "Μου αρέσει ο καφές."
        ],
        [
          "Σε σένα",
          "σου αρέσει",
          "Σου αρέσει η μουσική;"
        ],
        [
          "Στον αυτόν",
          "του/της αρέσει",
          "Του αρέσει το ταξίδι."
        ],
        [
          "Σε μας",
