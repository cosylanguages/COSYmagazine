          "Μας αρέσει ο αθλητισμός."
        ],
        [
          "Σε σας",
          "σας αρέσει",
          "Σας αρέσει το σινεμά;"
        ],
        [
          "Σε αυτούς",
          "τους αρέσει",
          "Τους αρέσει το διάβασμα."
        ]
